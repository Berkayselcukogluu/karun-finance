# ==========================================
# Settings file for the MarketBoard app.
# Copy this file, rename it to .env, and type your own secret keys and passwords inside.
# ==========================================

# 1. Secret keys to get stock market and financial data
# Go to this website to sign up and get a free key from Finnhub: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Go to this website to get a key from Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# 2. Settings to connect the app to OpenAI's artificial intelligence
# Visit this page to create and get your secret AI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Settings to connect the app to your PostgreSQL database, where the app stores its information
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=fintechrssdb

# 4. Settings for Redis, a tool that stores temporary data to make the app faster.
# Optional: if Redis is not available, the app automatically uses your computer's regular memory.
REDIS_URL=redis://localhost:6379/0